# Neon (added automatically when you connect Neon in Vercel → Storage)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth — a long random string (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Your production URL, e.g. https://dg-work-hub.vercel.app
BETTER_AUTH_URL=

# GitHub OAuth App (github.com/settings/developers → New OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only these e-mails can sign in (comma-separated). Must match your GitHub primary e-mail.
ALLOWED_EMAILS=
